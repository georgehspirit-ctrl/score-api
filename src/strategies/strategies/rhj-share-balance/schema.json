{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/Strategy",
  "definitions": {
    "Strategy": {
      "title": "Strategy",
      "type": "object",
      "properties": {
        "symbol": {
          "type": "string",
          "title": "Symbol",
          "examples": ["e.g. CRWD"],
          "maxLength": 16
        },
        "address": {
          "type": "string",
          "title": "Token contract address",
          "description": "Address of the Robinhood Assets Jersey (RHJ) stock token. Must expose uiMultiplier().",
          "examples": ["e.g. 0xea72Ecca2d0f6bFA1394DBBCff85b52CD4233931"],
          "pattern": "^0x[a-fA-F0-9]{40}$",
          "minLength": 42,
          "maxLength": 42
        },
        "decimals": {
          "type": "number",
          "title": "Decimals",
          "description": "Token decimals. Every RHJ token is 18. This only controls how the share count is formatted; the multiplier is always divided by 1e18.",
          "examples": ["e.g. 18"],
          "minimum": 0
        }
      },
      "required": ["address", "decimals"],
      "additionalProperties": false
    }
  }
}
